# environment variables, not in this repo.
.env
.env.*
!.env.example
*.key
*.pem

# Dependencies — Netlify installs these at build time from package.json
node_modules/

# Netlify local state
.netlify/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
